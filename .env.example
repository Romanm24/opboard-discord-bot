# Copy this file to .env and fill in your own values — never commit .env or share it.

# From the Discord Developer Portal → your app → Bot → Token
DISCORD_TOKEN=your-bot-token-here

# From the Developer Portal → your app → General Information → Application ID
CLIENT_ID=your-application-id-here

# Right-click your test server icon in Discord (Developer Mode must be on) → Copy Server ID
GUILD_ID=your-test-server-id-here
